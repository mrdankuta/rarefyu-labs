#!/usr/bin/env python3
"""Move files between the learner's laptop and the workspace (spec: file transfer).

  lab-transfer ROOT zip-out SUB [--heavy]   zip of ROOT/SUB to stdout (skips node_modules, .git, ... unless --heavy)
  lab-transfer ROOT cat PATH                raw bytes of one file to stdout
  lab-transfer ROOT put DEST                framed files on stdin -> ROOT/DEST   (frame: u32 pathlen, path, u64 size, bytes)
  lab-transfer ROOT unzip DEST              a zip on stdin -> ROOT/DEST
put/unzip print {"files":N,"bytes":N,"skipped":N} on stdout. Errors: one line on stderr, exit 2.
Every path is resolved and must stay inside ROOT; symlinks are never written or followed out.
"""
import io, json, os, struct, sys, zipfile

MAX_FILES = int(os.environ.get("LAB_MAX_FILES", 5000))
MAX_BYTES = int(os.environ.get("LAB_MAX_BYTES", 100 * 1024 * 1024))   # per upload
MAX_FILE = int(os.environ.get("LAB_MAX_FILE", 25 * 1024 * 1024))
MAX_WORKSPACE = int(os.environ.get("LAB_MAX_WORKSPACE", 1024 * 1024 * 1024))
HEAVY = {"node_modules", ".git", ".svelte-kit", ".next", ".cache", "__pycache__", ".venv", "__MACOSX"}
JUNK = {".DS_Store", "Thumbs.db"}


def die(msg):
    sys.stderr.write(msg + "\n")
    sys.exit(2)


def inside(root, path):
    root = os.path.realpath(root)
    p = os.path.realpath(path)
    return p == root or p.startswith(root + os.sep)


def safe_dest(root, rel):
    rel = rel.replace("\\", "/")
    if rel.startswith("/") or "\x00" in rel:
        die(f"bad path: {rel!r}")
    parts = [p for p in rel.split("/") if p not in ("", ".")]
    if ".." in parts:
        die(f"bad path: {rel!r}")
    full = os.path.join(root, *parts)
    if not inside(root, full):
        die(f"path escapes workspace: {rel!r}")
    return full, parts


def skipped(parts):
    return any(p in HEAVY for p in parts) or (parts and parts[-1] in JUNK)


def tree_size(root):
    total = 0
    for d, dirs, files in os.walk(root):
        dirs[:] = [x for x in dirs if x not in HEAVY]
        for f in files:
            try:
                total += os.lstat(os.path.join(d, f)).st_size
            except OSError:
                pass
    return total


class Budget:
    def __init__(self, root):
        self.files = 0
        self.bytes = 0
        self.skipped = 0
        self.base = tree_size(root)

    def take(self, size):
        self.files += 1
        self.bytes += size
        if self.files > MAX_FILES:
            die(f"too many files (limit {MAX_FILES}); leave out node_modules and build folders")
        if size > MAX_FILE:
            die(f"a file is larger than {MAX_FILE // (1024 * 1024)} MB")
        if self.bytes > MAX_BYTES:
            die(f"upload is larger than {MAX_BYTES // (1024 * 1024)} MB")
        if self.base + self.bytes > MAX_WORKSPACE:
            die("your workspace is full; delete something first")


def write_file(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    if os.path.islink(path):
        os.unlink(path)
    with open(path, "wb") as f:
        f.write(data)
    os.chmod(path, 0o644)


def read_exact(stream, n):
    buf = b""
    while len(buf) < n:
        chunk = stream.read(n - len(buf))
        if not chunk:
            die("upload stream ended early")
        buf += chunk
    return buf


def cmd_put(root, dest):
    base, _ = safe_dest(root, dest)
    b = Budget(root)
    out = sys.stdin.buffer
    while True:
        head = out.read(4)
        if not head:
            break
        if len(head) < 4:
            die("upload stream ended early")
        (plen,) = struct.unpack(">I", head)
        if plen == 0 or plen > 1024:
            die("bad path length")
        rel = read_exact(out, plen).decode("utf-8", "replace")
        (size,) = struct.unpack(">Q", read_exact(out, 8))
        if size > MAX_FILE:
            die(f"a file is larger than {MAX_FILE // (1024 * 1024)} MB")
        data = read_exact(out, size)
        full, parts = safe_dest(base, rel)
        if skipped(parts):
            b.skipped += 1
            continue
        b.take(size)
        write_file(full, data)
    print(json.dumps({"files": b.files, "bytes": b.bytes, "skipped": b.skipped}))


def cmd_unzip(root, dest):
    base, _ = safe_dest(root, dest)
    raw = sys.stdin.buffer.read(MAX_BYTES + 1)
    if len(raw) > MAX_BYTES:
        die(f"zip is larger than {MAX_BYTES // (1024 * 1024)} MB")
    try:
        zf = zipfile.ZipFile(io.BytesIO(raw))
    except zipfile.BadZipFile:
        die("that is not a valid zip file")
    b = Budget(root)
    # Declared sizes can lie, so also count bytes as they are actually produced.
    for info in zf.infolist():
        if info.is_dir():
            continue
        if (info.external_attr >> 16) & 0o170000 == 0o120000:  # symlink entry
            b.skipped += 1
            continue
        full, parts = safe_dest(base, info.filename)
        if skipped(parts):
            b.skipped += 1
            continue
        b.take(info.file_size)
        buf = bytearray()
        with zf.open(info) as src:
            while True:
                chunk = src.read(65536)
                if not chunk:
                    break
                buf += chunk
                if len(buf) > MAX_FILE or b.bytes - info.file_size + len(buf) > MAX_BYTES:
                    die("zip expands to more than the allowed size")
        write_file(full, bytes(buf))
    print(json.dumps({"files": b.files, "bytes": b.bytes, "skipped": b.skipped}))


def cmd_zip_out(root, sub, heavy):
    top, _ = safe_dest(root, sub)
    if not os.path.isdir(top):
        die("no such folder")
    out = sys.stdout.buffer
    with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as zf:
        for d, dirs, files in os.walk(top):
            dirs[:] = sorted(x for x in dirs if heavy or x not in HEAVY)
            for f in sorted(files):
                full = os.path.join(d, f)
                if os.path.islink(full) or (not heavy and f in JUNK):
                    continue
                zf.write(full, os.path.relpath(full, top))


def cmd_cat(root, path):
    full, _ = safe_dest(root, path)
    if not os.path.isfile(full) or os.path.islink(full):
        die("no such file")
    with open(full, "rb") as f:
        while True:
            chunk = f.read(65536)
            if not chunk:
                break
            sys.stdout.buffer.write(chunk)


def main():
    a = sys.argv[1:]
    if len(a) < 3:
        die("usage: lab-transfer ROOT zip-out|cat|put|unzip ARG [--heavy]")
    root, mode, arg = a[0], a[1], a[2]
    os.makedirs(root, exist_ok=True)
    if mode == "zip-out":
        cmd_zip_out(root, arg, "--heavy" in a)
    elif mode == "cat":
        cmd_cat(root, arg)
    elif mode == "put":
        cmd_put(root, arg)
    elif mode == "unzip":
        cmd_unzip(root, arg)
    else:
        die(f"unknown mode {mode}")


main()
