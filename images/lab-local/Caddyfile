# One port for the whole student app: web UI, API, terminal sockets, previews.
{
  admin off
  auto_https off
}
:{$LAB_PORT:3000} {
  bind 0.0.0.0
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    -Server
  }
  reverse_proxy /api/* 127.0.0.1:3100
  reverse_proxy /ws/* 127.0.0.1:3100
  reverse_proxy /preview/* 127.0.0.1:3100
  reverse_proxy 127.0.0.1:3101
}
