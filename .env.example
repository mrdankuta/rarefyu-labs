# Copy to .env and fill in. Never commit .env.
# --- required ---
ADMIN_TOKEN=replace-with-long-random      # bearer token for kill switch / pause / reconcile
PREVIEW_SECRET=replace-with-long-random   # signs preview URLs
BETTER_AUTH_SECRET=replace-with-32-plus-random-chars
# --- site ---
SITE_ADDRESS=:80                          # or labs.example.com for automatic HTTPS
BETTER_AUTH_URL=http://localhost
# --- web ---
PUBLIC_DEFAULT_LAYOUT=                    # set to "classic" to force the Classic lab layout and hide the Chat toggle (read at runtime; restart web)
# --- workspaces (single VPS) ---
DRIVER=docker-gvisor                      # docker-gvisor (prod) | docker (dev, weaker) | local (no isolation)
LAB_IMAGE=rarefyu/base-lab:dev            # pin by digest in production
SEATS_REQUIRED=0                          # 1 = students must enter a class code
SEAT_TTL_MIN=480                          # how long a class workspace lives (minutes)
SEAT_DEFAULT_MODEL=opencode-go/muse-spark-1.3-contributor    # model preselected for seat holders
MAX_WORKSPACES_GLOBAL=20
MAX_WORKSPACES_PER_IP=3
WORKSPACE_CPUS=1
WORKSPACE_MEMORY=2g
GRADING_ENABLED=0                         # keep 0 on any shared host: grading runs check scripts on the API host. 1 only for local dev/tests
# --- written by infra/provision-vps.sh ---
DOCKER_GID=999
POSTGRES_PASSWORD=labs
# --- class seats on Convex (optional; without CONVEX_URL seats live in a JSON file) ---
# Students' containers need only CONVEX_URL. The hosted API / scripts/seats.ts also need the admin secret.
CONVEX_URL=
CONVEX_ADMIN_SECRET=
