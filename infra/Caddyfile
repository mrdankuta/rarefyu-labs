# Plain HTTP by default; set SITE_ADDRESS=labs.example.com in .env for automatic HTTPS.
# Site address comes from SITE_ADDRESS (default ":80" = plain HTTP; set to your domain for automatic HTTPS).
{$SITE_ADDRESS::80} {
  # Security headers on every response (bench + prod).
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy no-referrer
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # Preview iframe content is served from /preview/* with its own sandbox
    # attribute; the shell itself must never be framed.
    -Server
  }
  # Grading is disabled while the API's GRADING_ENABLED switch is off (the
  # default). Belt and braces: even if the switch is flipped by mistake, the
  # public proxy never forwards the grade route. Remove this block only when
  # grading runs in an isolated sandbox (see docs/labs-platform/vps-deploy-notes.md).
  @grade path_regexp ^/api/playgrounds/[^/]+/grade/?$
  handle @grade {
    respond `{"error":"grading is unavailable","code":"grading_disabled"}` 503 {
      close
    }
  }

  reverse_proxy /api/* 127.0.0.1:3000
  reverse_proxy /ws/* 127.0.0.1:3000
  reverse_proxy /preview/* 127.0.0.1:3000
  reverse_proxy 127.0.0.1:3001
}
