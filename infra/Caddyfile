# Bench default: plain HTTP (no public DNS / ACME on the laptop).
# Production (Hetzner): replace :80 with https://labs.<domain> + tls <email>.
:80 {
  # Security headers on every response (bench + prod).
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy no-referrer
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # Preview iframe content is served from /preview/* with its own sandbox
    # attribute; the shell itself must never be framed.
    -Server
  }
  reverse_proxy /api/* api:3000
  reverse_proxy /ws/* api:3000
  reverse_proxy /preview/* api:3000
  reverse_proxy web:3000
}
